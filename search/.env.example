# Database Configuration
# For local development, use: flyctl proxy 5432 -a kalshi-search-db
# Then connect to: postgresql://postgres:slqn0lXbjUD0tq3@localhost:5432/postgres
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/postgres

# Kalshi API Configuration
KALSHI_API_KEY=your-api-key-here
KALSHI_PRIVATE_KEY_PATH=/path/to/private-key.pem
# Or use the private key directly:
# KALSHI_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# API Configuration
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# CORS Configuration
CORS_ORIGIN=*
