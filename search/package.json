{
  "name": "kalshi-search-service",
  "version": "1.0.0",
  "description": "Ultra-simple search service for Kalshi prediction markets (in-memory cache, no database!)",
  "main": "dist/api/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "build": "tsc",
    "start": "node dist/api/server.js",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "check": "pnpm run lint && pnpm run format:check && pnpm exec tsc --noEmit"
  },
  "packageManager": "pnpm@9.0.0",
  "keywords": [
    "kalshi",
    "prediction-markets",
    "search",
    "api",
    "in-memory",
    "typescript"
  ],
  "author": "Sean Lee",
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@hono/zod-validator": "^0.4.1",
    "dotenv": "^16.4.5",
    "hono": "^4.6.10",
    "kalshi-typescript": "^2.1.3",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "@typescript-eslint/eslint-plugin": "^8.1.0",
    "@typescript-eslint/parser": "^8.1.0",
    "eslint": "^9.9.0",
    "prettier": "^3.3.3",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
