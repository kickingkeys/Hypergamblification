# OpenAI API
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-key-here

# Kalshi API
# Get credentials from: https://kalshi.com (Account Settings → API)
KALSHI_API_KEY_ID=your-kalshi-key-id-here
KALSHI_PRIVATE_KEY_PATH=./kalshi-private-key.pem

# Optional: Google Cloud Vision (if using instead of Tesseract)
# GOOGLE_APPLICATION_CREDENTIALS=./google-credentials.json

# Development
NODE_ENV=development
